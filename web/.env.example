# Public URL of the dashboard.json published by the pipeline to Vercel Blob.
# Leave unset locally to use web/fixtures/dashboard.sample.json.
NEXT_PUBLIC_DASHBOARD_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Classic league id for the live-scores overlay (defaults to 218144 if unset)
NEXT_PUBLIC_CLASSIC_LEAGUE_ID=218144

# GH_DISPATCH_TOKEN= (server-only, set in Vercel as Secret — never NEXT_PUBLIC)
